<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Portfólio</title>
<style>
  :root{--bg:#f6f7f9;--card:#fff;--ink:#1c2230;--muted:#6b7280;--line:#e3e6ec;--accent:#0e6e5c;--accent-soft:#e3f1ee;--warn:#7a5000;--warn-bg:#fbf1dc;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  @media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#121417;--card:#1b1e24;--ink:#e8eaf0;--muted:#9aa1ad;--line:#2a2f38;--accent:#5fd0b8;--accent-soft:#1d2f2b;--warn:#f3c96b;--warn-bg:#2c2516}}
  :root[data-theme="dark"]{--bg:#121417;--card:#1b1e24;--ink:#e8eaf0;--muted:#9aa1ad;--line:#2a2f38;--accent:#5fd0b8;--accent-soft:#1d2f2b;--warn:#f3c96b;--warn-bg:#2c2516}
  *{box-sizing:border-box}
  [hidden]{display:none!important}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;padding-bottom:56px}
  header.top{position:sticky;top:0;z-index:10;background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:10px 16px;flex-wrap:wrap}
  header.top .title{font-weight:700;font-size:17px;flex:1;min-width:120px}
  button{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:7px 12px;cursor:pointer}
  button:hover{border-color:var(--accent);color:var(--accent)}
  button.pri{background:var(--accent);border-color:var(--accent);color:#fff}
  button.pri:hover{color:#fff;opacity:.92}
  button:disabled{opacity:.5;cursor:default}
  .acoes{display:flex;gap:8px;flex-wrap:wrap}
  nav#tabs{display:flex;gap:4px;padding:10px 16px 0;border-bottom:1px solid var(--line);background:var(--card);overflow-x:auto}
  nav#tabs button{border:0;border-bottom:3px solid transparent;border-radius:0;background:transparent;padding:10px 14px;color:var(--muted);white-space:nowrap}
  nav#tabs button.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
  main{max-width:1200px;margin:0 auto;padding:18px 16px}
  .modo{color:var(--muted);font-size:14px;min-height:20px;margin-bottom:8px}
  .banner{background:var(--warn-bg);color:var(--warn);border-radius:10px;padding:12px 14px;margin-bottom:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .banner button{background:transparent;color:inherit;border-color:currentColor}
  .barra{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
  .mut{color:var(--muted)}
  .vazio{background:var(--card);border:1px dashed var(--line);border-radius:12px;padding:30px;text-align:center}
  .tbl{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow-x:auto}
  table.t{border-collapse:collapse;width:100%;min-width:1100px;font-size:14px}
  table.t th,table.t td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  table.t th{background:var(--accent-soft);font-weight:600;position:sticky;top:0}
  table.t td.ativo{background:var(--bg);min-width:170px}
  table.t td.num,table.t th.num{text-align:right;white-space:nowrap}
  .fld{width:100%;font:inherit;font-size:14px;padding:6px 8px;border:1px solid var(--line);border-radius:7px;background:var(--card);color:var(--ink);min-width:110px}
  textarea.fld{resize:vertical;min-width:160px}
  .acoes-ativo{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
  .lnk{border:0;background:transparent;color:var(--accent);padding:2px 0;font-size:13px}
  .lnk.perigo{color:#b00020}
  .xbtn{border:0;background:transparent;color:#b00020;font-size:18px;padding:2px 8px}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
  .kpi{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
  .kl{color:var(--muted);font-size:13px}
  .kv{font-size:26px;font-weight:700;margin-top:4px}
  .kv.sm{font-size:16px;margin-top:8px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:12px}
  .card h3{margin:0 0 12px;font-size:16px}
  .barras{display:flex;align-items:flex-end;gap:8px;height:200px;padding-top:10px;overflow-x:auto}
  .bcol{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:42px;flex:1}
  .bcol span{font-size:12px;color:var(--muted);margin-bottom:4px}
  .bar{width:100%;max-width:56px;background:var(--accent);border-radius:6px 6px 0 0;min-height:3px}
  .bcol small{font-size:12px;color:var(--muted);margin-top:6px}
  .ver{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
  .ver:last-child{border-bottom:0}
  .ver small{color:var(--muted)}
  .ver span{color:var(--accent);font-weight:600;font-size:13px}
  #statusBar{position:fixed;left:0;right:0;bottom:0;z-index:12;background:var(--card);border-top:1px solid var(--line);font-size:13px;color:var(--muted);padding:8px 16px;display:flex;gap:12px;justify-content:space-between;flex-wrap:wrap}
  #status{color:var(--ink)}
  .painel{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:30;display:flex;align-items:center;justify-content:center;padding:16px}
  .caixa{background:var(--card);border-radius:14px;max-width:480px;width:100%;padding:22px}
  .caixa h3{margin:0 0 10px}
  .caixa textarea{width:100%;min-height:90px;font:inherit;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
  .caixa .acoes{justify-content:flex-end;margin-top:14px}
  @media (max-width:700px){ main{padding:12px} .kv{font-size:22px} }
</style>
</head>
<body>
<div id="__gateOverlay" style="position:fixed;inset:0;z-index:2147483647;background:#0d0f12;color:#f3f5f8;display:flex;align-items:center;justify-content:center;font-family:Inter,system-ui,sans-serif;text-align:center;padding:20px;">
  <div style="max-width:320px;width:100%;"><div id="__gateMsg" style="font-size:14px;color:#8a919c;line-height:1.6;">Verificando acesso...</div></div>
</div>

<header class="top">
  <span class="title">Portfólio</span>
  <button id="btnCsv">Exportar planilha</button>
  <button id="btnEditar" class="pri">Editar</button>
  <button id="btnCancelar" hidden>Cancelar</button>
  <button id="btnSalvar" class="pri" hidden>Salvar versão</button>
  <button id="themeBtn">Tema</button>
</header>
<nav id="tabs">
  <button data-tab="ativos" class="on">Ativos</button>
  <button data-tab="visao">Visão geral</button>
  <button data-tab="historico">Histórico</button>
</nav>

<main>
  <div id="bannerRemoto" class="banner" hidden><span>Outra pessoa salvou uma versão nova enquanto você editava.</span><button id="btnCarregarRemoto">Carregar versão nova (descarta suas edições)</button></div>
  <div id="bannerRascunho" class="banner" hidden><span>Existe um rascunho não salvo guardado na nuvem por <b id="autorRascunho"></b>.</span><button id="btnRecuperarRascunho">Recuperar</button><button id="btnDescartarRascunho">Descartar</button></div>
  <div id="modoTxt" class="modo"></div>
  <div id="conteudo"></div>
</main>

<div id="statusBar"><span id="status"></span><span id="versaoTxt">Carregando...</span></div>

<div id="salvarPainel" class="painel" hidden>
  <div class="caixa">
    <h3>Salvar nova versão</h3>
    <div class="mut" style="margin-bottom:10px">Essa versão fica no histórico. Nada é apagado, e você pode voltar a qualquer versão.</div>
    <textarea id="notaSalvar" placeholder="O que mudou? (opcional)"></textarea>
    <div class="acoes"><button id="btnSalvarVoltar">Voltar</button><button id="btnSalvarOk" class="pri">Salvar</button></div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/12.16.0/firebase-app-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/12.16.0/firebase-auth-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/12.16.0/firebase-database-compat.min.js"></script>
<script>
(function(){
  /* CADEADO PADRÃO DA ESTANTE. Só esta linha muda. */
  var GRUPOS_PERMITIDOS = ["EQUIVALENCIA"];
  var firebaseConfig = {
    apiKey: "AIzaSyCpG7o-CF3twF0Jti0bRchrS97SWYQBuyo",
    authDomain: "stinpharma-qualidade.firebaseapp.com",
    databaseURL: "https://stinpharma-qualidade-default-rtdb.firebaseio.com",
    projectId: "stinpharma-qualidade",
    storageBucket: "stinpharma-qualidade.firebasestorage.app",
    messagingSenderId: "422803826984",
    appId: "1:422803826984:web:6e72e2470f3678eb8d881d",
    measurementId: "G-6C0TLHH2VP"
  };
  if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
  function norm(x){ return String(x).normalize("NFD").replace(/[̀-ͯ]/g,"").toUpperCase().trim(); }
  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function liberar(){
    var ov = document.getElementById('__gateOverlay');
    if(ov) ov.remove();
    window.__gateOk = true;
    if(window.__startApp) window.__startApp();
  }
  function negar(msg){
    document.getElementById('__gateMsg').innerHTML = msg + '<br><br><a href="./index.html" style="color:#4d9fff;">&larr; Voltar pra Estante</a>';
  }
  var jaResolveu = false;
  setTimeout(function(){
    if(!jaResolveu) negar('Não foi possível confirmar seu acesso (conexão lenta ou instável). <a href="javascript:location.reload()" style="color:#4d9fff;">Tentar de novo</a>');
  }, 10000);
  firebase.auth().onAuthStateChanged(function(user){
    jaResolveu = true;
    if(!user){ negar('Você precisa entrar pela Estante.'); return; }
    firebase.database().ref('centralApps/usuarios/' + user.uid).once('value').then(function(snap){
      var dados = snap.val() || {};
      var lista = (dados.grupos || []).slice();
